{
  "name": "@skeptrune/sherp-cli",
  "version": "0.1.2",
  "description": "CLI tool for creating Marp-style presentations with Markdown/MDX",
  "type": "module",
  "bin": {
    "sherp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "presentation",
    "slides",
    "markdown",
    "mdx",
    "marp",
    "cli"
  ],
  "author": "skeptrunedev",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skeptrunedev/sherp.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@skeptrune/sherp-astro": "*",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "commander": "^14.0.2",
    "gray-matter": "^4.0.3",
    "ora": "^9.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
