---
import type { SlideDirectives } from '../lib/remarkSplitSlides';
import { getSlideStyles, getEffectiveDirective } from '../lib/slideParser';

interface Props {
  directives: SlideDirectives;
  slideNumber: number;
  totalSlides: number;
}

const { directives, slideNumber, totalSlides } = Astro.props;

const slideStyles = getSlideStyles(directives);
const showPaginate = getEffectiveDirective(directives, 'paginate');
const header = getEffectiveDirective(directives, 'header');
const footer = getEffectiveDirective(directives, 'footer');
const className = getEffectiveDirective(directives, 'class');
---

<section
  class:list={['slide', className]}
  style={slideStyles}
  data-slide={slideNumber}
>
  {header && <header class="slide-header" set:html={header} />}

  <div class="slide-content">
    <slot />
  </div>

  {footer && <footer class="slide-footer" set:html={footer} />}

  {
    showPaginate && (
      <div class="slide-page-number">
        {slideNumber} / {totalSlides}
      </div>
    )
  }
</section>

<style>
  .slide {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    position: relative;
    padding: clamp(20px, 4vw, 70px);
    box-sizing: border-box;
    overflow: hidden;
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    line-height: 1.6;
  }

  @container (max-width: 800px) {
    .slide {
      font-size: clamp(0.8rem, 2vw, 1.5rem);
    }
  }

  .slide-header {
    position: absolute;
    top: clamp(15px, 2vw, 30px);
    left: clamp(20px, 4vw, 70px);
    right: clamp(20px, 4vw, 70px);
    font-size: 0.9em;
    opacity: 0.7;
  }

  .slide-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow-y: auto;
    overflow-x: hidden;
    min-height: 0;
  }

  .slide-content > :global(div) {
    width: 100%;
    margin: auto 0;
    padding: clamp(10px, 2vw, 20px) 0;
  }

  .slide-footer {
    position: absolute;
    bottom: clamp(15px, 2vw, 30px);
    left: clamp(20px, 4vw, 70px);
    right: clamp(20px, 4vw, 70px);
    font-size: 0.9em;
    opacity: 0.7;
  }

  .slide-page-number {
    position: absolute;
    bottom: clamp(8px, 1.5vw, 15px);
    right: clamp(8px, 1.5vw, 15px);
    font-size: clamp(0.6rem, 1.2vw, 0.8rem);
    opacity: 0.5;
    z-index: 10;
  }

  .slide :global(h1) {
    font-size: 2.5em;
    margin: 0.3em 0 0.5em 0;
  }

  .slide :global(h2) {
    font-size: 2em;
    margin: 0.3em 0 0.5em 0;
  }

  .slide :global(h3) {
    font-size: 1.5em;
    margin: 0.3em 0 0.5em 0;
  }

  .slide :global(h1:first-child),
  .slide :global(h2:first-child),
  .slide :global(h3:first-child) {
    margin-top: 0;
  }

  .slide :global(ul),
  .slide :global(ol) {
    margin: 0.5em 0;
    padding-left: 1.5em;
  }

  .slide :global(li) {
    margin: 0.3em 0;
  }

  .slide :global(code) {
    background: rgba(128, 128, 128, 0.1);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  .slide :global(pre) {
    background: rgba(128, 128, 128, 0.1);
    padding: 1em;
    border-radius: 5px;
    overflow-x: auto;
    font-size: 0.8em;
  }

  .slide :global(pre code) {
    background: none;
    padding: 0;
  }

  .slide :global(blockquote) {
    border-left: 4px solid currentColor;
    margin: 1em 0;
    padding-left: 1em;
    opacity: 0.7;
  }

  .slide :global(img) {
    max-width: 100%;
    height: auto;
  }

  .slide :global(table) {
    border-collapse: collapse;
    width: 100%;
    margin: 1em 0;
  }

  .slide :global(th),
  .slide :global(td) {
    border: 1px solid currentColor;
    padding: 0.5em;
    text-align: left;
  }

  .slide :global(th) {
    font-weight: bold;
  }
</style>
